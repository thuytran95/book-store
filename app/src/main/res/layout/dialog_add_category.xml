<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/txtDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thêm Thể Loại Mới"
        android:textColor="@color/on_surface"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Tên thể loại *"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtDialogCatName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:autofillHints="name"
        android:background="@drawable/bg_search_box"
        android:hint="VD: Văn học nước ngoài"
        android:inputType="text"
        android:paddingHorizontal="14dp"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Mã viết tắt *"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtDialogCatCode"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:autofillHints="name"
        android:background="@drawable/bg_search_box"
        android:hint="VD: VL"
        android:inputType="text"
        android:paddingHorizontal="14dp"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelCat"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Hủy"
            android:textColor="@color/on_surface_variant"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btnSaveCat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/primary"
            android:text="Thêm mới"
            android:textColor="@color/white"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
